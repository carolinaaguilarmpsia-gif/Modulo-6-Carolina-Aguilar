# Copiar a .env (gitignored) y ajustar si hace falta.

# JWT_SECRET=cambia-esto-en-produccion

# Asistente de trámites DPA (chat público en el login). En false, el router nunca usa el
# LLM: solo responde lo que resuelve el camino "keyword" y el resto cae al fallback.
IA_HABILITADA=true

# Asistente IA (rung 0) — Ollama corriendo localmente, sin API key.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# RAG del asistente de trámites (Nivel 3) — embeddings locales vía Ollama, mismo host.
# Requiere `ollama pull nomic-embed-text` una vez. Si Ollama no responde, el router degrada
# solo al siguiente paso (LLM-tool-router o keyword) — no tumba el asistente.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Bonus "comparar modelos" — Groq (tier gratis, sin tarjeta).
# Sacar la key en https://console.groq.com/keys y pegarla en tu .env local
# (NUNCA en el código, en el repo, ni en capturas de pantalla):
# Nota: los modelos de Groq rotan seguido (deprecan modelos "instant" viejos) — si da 404
# model_not_found, listar los vigentes en https://console.groq.com/docs/models para tu cuenta.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini — probado y descartado por un bloqueo a nivel de proyecto de Google
# ("PERMISSION_DENIED"), no del código. El adaptador (GeminiClient.ts) queda listo
# por si se resuelve el acceso más adelante.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Si en el futuro se agrega otro proveedor de pago, su API key va acá igual:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
